{
  "name": "smart-travel-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Travel Guide - Web application for travel planning with map integration (Đồ án Thực tế CNPM)",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf .next node_modules/.cache",
    "prepare": "echo 'Project ready'",
    "db:check": "echo 'Cách tốt nhất: Start the app (npm run dev), go to /admin, enter your webhook secret, and click the green \"Check DB Consistency\" button.\n   It will call the new db.check event and show a full report of expected vs actual collections, old duplicates, etc.'",
    "db:drop-unknown": "echo 'Use the admin panel or POST {\"event\":\"db.dropUnknown\"} to /api/webhook (with x-webhook-secret header).'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.0",
    "jose": "^6.2.3",
    "mongoose": "^9.6.3",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd"
}
