MONGODB_URI=mongodb://localhost:27017/smart-travel-guide
TEST_MONGODB_URI=mongodb://localhost:27017/smart_travel_guide_test
E2E_MONGODB_URI=mongodb://localhost:27017/smart_travel_guide_e2e
REDIS_URL=redis://localhost:6379

# Có thể là 1 khóa, hoặc DANH SÁCH phân tách bởi dấu phẩy để xoay vòng khóa
# (zero-downtime): khóa ĐẦU = khóa ký mới, các khóa sau = khóa cũ chỉ để verify.
# Ví dụ khi rotate: JWT_SECRET=khoa-moi,khoa-cu
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-secure-admin-password
# Tùy chọn an toàn hơn: dùng ADMIN_PASSWORD_HASH thay cho ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
NEXT_PUBLIC_APP_URL=http://localhost:3000


DEBUG_SECRET=replace-with-a-secure-debug-secret
API_KEY_RESEND=re_xxxxxxxxxxxxxxxxxxxxxxxxx

WEBHOOK_SECRET=replace-with-admin-webhook-secret
WEBHOOK_IP_ALLOWLIST=

# Dải CIDR của reverse proxy tin cậy (vd Cloudflare), phân tách bởi dấu phẩy.
# Mặc định rỗng = chỉ tin các dải nội bộ (private/loopback). Xem docs/deployment/reverse-proxy.md
TRUSTED_PROXY_CIDRS=

CRON_SECRET=replace-with-a-secure-cron-secret
